# ── Claude Code via IBM Consulting Advantage ──────────────────────────
# Copy this file to .env and fill in your credentials.
# Local dev: set CLAUDE_API_KEY directly.
# Production: set CLAUDE_SECRET_NAME to the secret name in your vault
#             (AWS Secrets Manager, IBM Secrets Manager, etc.) and leave
#             CLAUDE_API_KEY empty — the SecretProvider fetches it at runtime.
CLAUDE_API_KEY=your-api-key-here
CLAUDE_SECRET_NAME=CLAUDE_API_KEY
CLAUDE_BASE_URL=https://api.nextgen-beta.ica.ibm.com/ica
CLAUDE_MODEL=claude-sonnet-4-5

# ── Storage ───────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./knowledge_platform.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=26214400

# ── Chunking ──────────────────────────────────────────────────────────
CHUNK_SIZE=3000
CHUNK_OVERLAP=200

# ── Graph traversal ───────────────────────────────────────────────────
GRAPH_HOP_DEPTH=2
GRAPH_STRENGTH_THRESHOLD=0.5
GRAPH_MAX_NODES=60

# ── Extraction quality ─────────────────────────────────────────────────
CONCEPT_CONFIDENCE_MIN=0.6

# ── Pattern extraction ─────────────────────────────────────────────────
# Minimum percentage growth in concepts or relationships required to re-run
# the pattern agent after a document is ingested. Set to 0 to always run.
PATTERN_EXTRACTION_THRESHOLD_PERCENT=10

# ── QA retrieval ───────────────────────────────────────────────────────
QA_TOP_K=20

# ── LLM Governance ─────────────────────────────────────────────────────
# Circuit breaker: open after N consecutive failures; recover after T seconds
LLM_CB_FAILURE_THRESHOLD=5
LLM_CB_RECOVERY_TIMEOUT=60

# Rate limiting: max LLM calls per workspace per minute
MAX_LLM_REQUESTS_PER_MINUTE=60
LLM_RATE_WINDOW_SECONDS=60

# Cost tracking: USD per 1 000 tokens (Claude Sonnet defaults)
LLM_COST_PER_1K_INPUT_TOKENS=0.003
LLM_COST_PER_1K_OUTPUT_TOKENS=0.015

# ── LLM Resilience — Timeouts ──────────────────────────────────────────
# All values in seconds. Set conservatively for streaming LLM responses.
LLM_CONNECT_TIMEOUT=10
LLM_READ_TIMEOUT=240
LLM_WRITE_TIMEOUT=30

# ── LLM Resilience — Retry strategy ───────────────────────────────────
# LLM_MAX_RETRIES: number of retries after the initial attempt (total = max_retries + 1)
# LLM_RETRY_MAX_WAIT: backoff ceiling in seconds (actual wait = exponential + jitter)
LLM_MAX_RETRIES=4
LLM_RETRY_MAX_WAIT=30

# ── Server ────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173

# ── Spreadsheet processing ─────────────────────────────────────────────
# Maximum rows read per sheet. Prevents memory exhaustion on large files.
SPREADSHEET_MAX_ROWS=10000
