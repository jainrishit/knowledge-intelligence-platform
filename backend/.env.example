# ── Claude Code via IBM Consulting Advantage ──────────────────────────
# Copy this file to .env and fill in your credentials.
CLAUDE_API_KEY=your-api-key-here
CLAUDE_BASE_URL=https://api.nextgen-beta.ica.ibm.com/ica
CLAUDE_MODEL=claude-sonnet-4-5

# ── Storage ───────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./bob_knowledge_fabric.db
UPLOAD_DIR=./uploads

# ── Chunking ──────────────────────────────────────────────────────────
CHUNK_SIZE=3000
CHUNK_OVERLAP=200

# ── Graph traversal ───────────────────────────────────────────────────
GRAPH_HOP_DEPTH=2
GRAPH_STRENGTH_THRESHOLD=0.5
GRAPH_MAX_NODES=60

# ── Extraction quality ─────────────────────────────────────────────────
CONCEPT_CONFIDENCE_MIN=0.6

# ── QA retrieval ───────────────────────────────────────────────────────
QA_TOP_K=20

# ── Server ────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173
